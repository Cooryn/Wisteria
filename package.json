{
  "name": "@cooryn/wisteria-claw",
  "version": "0.1.0",
  "description": "OpenClaw plugin for discovering GitHub contribution opportunities and preparing draft PRs.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "examples",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "clean": "rimraf dist"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": ">=2026.3.24-beta.2"
    },
    "install": {
      "minHostVersion": ">=2026.3.24"
    }
  },
  "dependencies": {
    "@octokit/rest": "latest",
    "@sinclair/typebox": "latest",
    "openclaw": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "rimraf": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
